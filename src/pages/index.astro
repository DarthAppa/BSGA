---
// Accueil PROVISOIRE (phase 0) : structure et contenu réel, sans l'identité visuelle (phase 2).
import Base from '../layouts/Base.astro';
import { SITE, CONTACT, ZONES, PRESTATIONS } from '../site.js';
---

<Base
    accueil
    titre={`${SITE.nom} — ${SITE.accroche}`}
    description="Ménage régulier, remise en état, nettoyage après chantier ou événement, intendance : BSGA intervient chez les particuliers à Grasse et alentours. Devis gratuit."
>
    <main id="contenu">
        <section id="accueil" class="wrap py-14 md:py-20 flex flex-col gap-6 max-w-3xl">
            <h1 class="text-3xl md:text-5xl font-bold leading-tight">{SITE.accroche}</h1>
            <p class="text-lg text-encreDouce">
                Une entreprise à taille humaine, pour un intérieur propre sans y passer vos week-ends.
            </p>
            <div class="flex flex-wrap gap-3">
                <a href={`tel:${CONTACT.telephoneLien}`} class="btn">Appeler le {CONTACT.telephone}</a>
                <a href={`mailto:${CONTACT.email}`} class="btn btn--secondaire">Écrire un email</a>
            </div>
        </section>

        <section id="prestations" class="bg-surface">
            <div class="wrap py-14 flex flex-col gap-6">
                <h2 class="text-2xl md:text-3xl font-bold">Nos prestations</h2>
                <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {PRESTATIONS.map((p) => (
                        <li class="prestation">
                            <h3 class="text-lg font-semibold">{p.nom}</h3>
                            <p class="text-sm text-encreDouce">Tarif {p.prix}</p>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <section id="zone" class="wrap py-14 flex flex-col gap-4">
            <h2 class="text-2xl md:text-3xl font-bold">Où intervenons-nous ?</h2>
            <p class="text-encreDouce max-w-3xl">
                Au départ de {CONTACT.ville} : {ZONES.coeur.join(', ')}. Et sur demande à {ZONES.elargie.join(', ')}.
            </p>
        </section>
    </main>
</Base>
