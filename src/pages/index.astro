---
// Accueil (maquette Figma « proposition 1 », identité noir et or).
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import { SITE, CONTACT, ZONES, PRESTATIONS, RESEAUX } from '../site.js';
import { MENTION_ESTIMATION } from '../tarifs.js';

const arguments_ = [
    {
        icone: 'devis',
        titre: 'Un devis clair et gratuit',
        texte: "Vous savez ce que vous payez avant l'intervention, déplacement compris.",
    },
    {
        icone: 'discretion',
        titre: 'Discrétion et respect',
        texte: 'Nous prenons soin de votre intérieur et de vos affaires, en toute confidentialité.',
    },
    {
        icone: 'lieu',
        titre: 'Une entreprise proche de vous',
        texte: `Basée à ${CONTACT.ville}, nous intervenons dans le pays grassois et jusqu'à Cannes et Valbonne.`,
    },
];

const etapes = [
    { titre: 'Vous décrivez votre besoin', texte: "Par téléphone, par email ou avec l'outil d'estimation en ligne." },
    { titre: 'Nous établissons votre devis', texte: 'Gratuitement, après un échange ou une visite sur place.' },
    { titre: 'Nous intervenons', texte: 'À la date convenue, puis nous vérifions le résultat avec vous.' },
];
---

<Base
    accueil
    titre={`${SITE.nom} - ${SITE.accroche}`}
    description="Ménage régulier, remise en état, nettoyage après chantier ou événement, intendance : BSGA intervient chez les particuliers à Grasse et alentours. Devis gratuit."
>
    <main id="contenu">
        <section id="accueil" class="hero">
            <div class="wrap flex flex-col items-center gap-6 py-20 text-center md:py-28">
                <h1 class="max-w-3xl text-4xl font-bold text-accentClair md:text-6xl">L'art du nettoyage soigné, à Grasse et alentours</h1>
                <p class="accroche">Des espaces impeccables, une image irréprochable.</p>
                <p class="max-w-2xl text-lg text-encreDouce">
                    Ménage régulier, remise en état, après chantier ou après événement : nous intervenons chez vous, avec
                    soin et discrétion.
                </p>
                <div class="flex w-full flex-col gap-3 pt-2 sm:w-auto sm:flex-row">
                    <a href="devis.html" class="btn">Demander un devis gratuit</a>
                    <a href={`tel:${CONTACT.telephoneLien}`} class="btn btn--secondaire">Appeler le {CONTACT.telephone}</a>
                </div>
            </div>
        </section>

        <section id="prestations" class="bg-surface">
            <div class="wrap flex flex-col gap-10 py-16 md:py-24">
                <div class="mx-auto flex max-w-2xl flex-col gap-3 text-center">
                    <h2 class="text-3xl font-semibold text-accent md:text-4xl">Nos prestations</h2>
                    <p class="text-encreDouce">
                        Cinq prestations, un même niveau d'exigence. Le prix dépend de la surface et du type d'intervention.
                    </p>
                </div>
                <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
                    {PRESTATIONS.map((p) => (
                        <li>
                            <a href={`prestations.html#${p.id}`} class="carte">
                                <span class="pastille"><Icone nom={p.icone} /></span>
                                <h3 class="text-lg font-semibold">{p.nom}</h3>
                                <p class="text-sm text-encreDouce">Tarif {p.prix}</p>
                                <span class="carte-lien">Voir le détail</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <section id="pourquoi">
            <div class="wrap flex flex-col gap-10 py-16 md:py-24">
                <h2 class="text-center text-3xl font-semibold text-accent md:text-4xl">Pourquoi BSGA ?</h2>
                <ul class="grid gap-10 md:grid-cols-3">
                    {arguments_.map((a) => (
                        <li class="flex flex-col gap-3">
                            <span class="pastille"><Icone nom={a.icone} /></span>
                            <h3 class="text-lg font-semibold">{a.titre}</h3>
                            <p class="text-encreDouce">{a.texte}</p>
                        </li>
                    ))}
                </ul>
                {RESEAUX.avisGoogle && (
                    <div class="encart flex flex-col gap-4 p-6 md:flex-row md:items-center md:justify-between md:p-8">
                        <div>
                            <h3 class="text-lg font-semibold">Ce que disent nos clients</h3>
                            <p class="text-encreDouce">Les avis de nos clients sont publiés et vérifiables sur notre fiche Google.</p>
                        </div>
                        <a href={RESEAUX.avisGoogle} class="btn btn--secondaire">Lire les avis sur Google</a>
                    </div>
                )}
            </div>
        </section>

        <section id="deroulement" class="bg-surface">
            <div class="wrap flex flex-col gap-10 py-16 md:py-24">
                <h2 class="text-center text-3xl font-semibold text-accent md:text-4xl">Comment ça se passe</h2>
                <ol class="grid gap-10 md:grid-cols-3">
                    {etapes.map((e, i) => (
                        <li class="flex flex-col gap-3">
                            <span class="etape-num" aria-hidden="true">{i + 1}</span>
                            <h3 class="text-lg font-semibold">{e.titre}</h3>
                            <p class="text-encreDouce">{e.texte}</p>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <section id="zone">
            <div class="wrap flex flex-col gap-6 py-16 md:py-24">
                <h2 class="text-3xl font-semibold text-accent md:text-4xl">Où intervenons-nous ?</h2>
                <p class="max-w-3xl text-encreDouce">
                    Au départ de {CONTACT.ville}, déplacement inclus à {ZONES.coeur.slice(0, 6).join(', ')} et dans les
                    communes voisines. Nous intervenons aussi à {ZONES.elargie.slice(0, 4).join(', ')}, Cannes et
                    alentours, avec un forfait de déplacement.
                </p>
                <p><a href="contact.html#zone-detail" class="lien">Voir toutes les communes</a></p>
            </div>
        </section>

        <section id="estimation" class="pb-16 md:pb-24">
            <div class="wrap">
                <div class="encart flex flex-col items-center gap-4 px-5 py-10 text-center md:px-16 md:py-14">
                    <h2 class="text-3xl font-semibold text-accent md:text-4xl">Obtenez une première estimation</h2>
                    <p class="max-w-2xl">
                        Choisissez la prestation, votre commune et la surface : l'outil vous donne un ordre de prix en
                        quelques clics.
                    </p>
                    <a href="devis.html" class="btn w-full sm:w-auto">Faire une estimation</a>
                    <p class="text-sm text-encreDouce">{MENTION_ESTIMATION}</p>
                </div>
            </div>
        </section>
    </main>
</Base>
