---
// En-tête commun à toutes les pages : nom, navigation, bouton d'appel, menu mobile.
// Les pages prestations, devis et contact arrivent en phases 3 et 4 : liens à ajouter ici à ce moment-là.
import { SITE, CONTACT } from '../site.js';

const liens = [{ href: 'index.html', texte: 'Accueil' }];
---

<header class="site-header">
    <div class="wrap flex items-center justify-between gap-4 py-3">
        <a href="index.html" class="text-xl font-bold text-encre" aria-label={`${SITE.nom}, accueil`}>{SITE.nom}</a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-medium" aria-label="Navigation principale">
            {liens.map((l) => <a href={l.href} class="nav-link">{l.texte}</a>)}
        </nav>

        <div class="flex items-center gap-2">
            <a href={`tel:${CONTACT.telephoneLien}`} class="btn">Appeler</a>
            <button
                type="button"
                id="burger"
                class="md:hidden grid place-items-center w-11 h-11 text-encre"
                aria-label="Menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
            </button>
        </div>
    </div>

    <nav id="mobile-menu" class="md:hidden hidden border-t border-ligne" aria-label="Navigation mobile">
        <div class="wrap py-4 flex flex-col gap-4 text-base font-medium">
            {liens.map((l) => <a href={l.href} class="nav-link">{l.texte}</a>)}
        </div>
    </nav>
</header>
