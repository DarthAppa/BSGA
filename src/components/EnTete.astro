---
// En-tête commun à toutes les pages : logo, navigation, bouton d'appel, menu mobile.
// Sans JS, le menu mobile reste visible sous l'en-tête (classe .no-js, voir style.css).
import Icone from './Icone.astro';
import { SITE, CONTACT } from '../site.js';

const liens = [
    { href: 'index.html', texte: 'Accueil' },
    { href: 'prestations.html', texte: 'Prestations' },
    { href: 'devis.html', texte: 'Devis' },
    { href: 'contact.html', texte: 'Contact' },
];
---

<header class="site-header">
    <div class="wrap flex items-center justify-between gap-4 py-3">
        <a href="index.html" class="logo" aria-label={`${SITE.nom}, accueil`}>
            <img src="assets/img/logo-bsga.svg" alt="" width="117" height="40" />
        </a>

        <nav class="hidden md:flex items-center gap-8 font-medium" aria-label="Navigation principale">
            {liens.map((l) => <a href={l.href} class="nav-link">{l.texte}</a>)}
        </nav>

        <div class="flex items-center gap-2">
            <a href={`tel:${CONTACT.telephoneLien}`} class="btn btn--secondaire hidden sm:inline-flex">
                {CONTACT.telephone}
            </a>
            <a href={`tel:${CONTACT.telephoneLien}`} class="btn btn--secondaire sm:hidden" aria-label={`Appeler le ${CONTACT.telephone}`}>
                <Icone nom="telephone" classe="w-5 h-5" />
            </a>
            <button
                type="button"
                id="burger"
                class="menu-bouton md:hidden"
                aria-label="Ouvrir le menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <Icone nom="menu" classe="w-6 h-6" />
            </button>
        </div>
    </div>

    <nav id="mobile-menu" class="menu-mobile md:hidden border-t border-ligne" aria-label="Navigation mobile">
        <div class="wrap py-2 flex flex-col text-lg font-medium">
            {liens.map((l) => <a href={l.href} class="nav-link">{l.texte}</a>)}
        </div>
    </nav>
</header>
